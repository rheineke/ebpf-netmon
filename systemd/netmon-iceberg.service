# Appends finished hours of /var/lib/netmon/raw to the Iceberg table.
# Install with scripts/install_converter.sh, which writes WAREHOUSE to
# /etc/default/netmon-iceberg.
[Unit]
Description=netmon raw JSON lines to Iceberg
After=network-online.target remote-fs.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/default/netmon-iceberg
ExecStart=/opt/netmon/venv/bin/python /opt/netmon/to_iceberg.py --warehouse ${WAREHOUSE}
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
