# Loads finished hours of raw files into the Iceberg table. Install with
# scripts/install_converter.sh, which writes WAREHOUSE, RAW and CATALOG to
# /etc/default/netmon-iceberg. An empty CATALOG means SQLite in WAREHOUSE.
[Unit]
Description=netmon raw JSON lines to Iceberg
# postgresql.service only orders the two when the catalog is PostgreSQL.
After=network-online.target remote-fs.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
# Not root (scripts/add_netmon_user.sh). The lock in /run and the run marker
# in /var/lib live in directories systemd makes for this user; the lock's
# outlives each run, since loads and maintenance share it.
User=netmon
RuntimeDirectory=netmon-iceberg
RuntimeDirectoryPreserve=yes
StateDirectory=netmon-iceberg
EnvironmentFile=/etc/default/netmon-iceberg
ExecStart=/opt/netmon/venv/bin/python /opt/netmon/to_iceberg.py --warehouse ${WAREHOUSE} --raw ${RAW} --catalog ${CATALOG}
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
