# Copies /var/lib/netmon/raw to DEST, e.g. a NAS folder for this host, where
# a converter loads it. Install with scripts/install_sync.sh, which writes
# DEST to /etc/default/netmon-sync. rsync renames each file into place once
# it is whole, and never deletes from DEST. Runs as netmon
# (scripts/add_netmon_user.sh), so DEST must be writable by that user. Each
# copy first checks that DEST is this machine's (scripts/sync_id.sh), so a
# copy of this SD card on another Pi stops rather than overwrite it.
[Unit]
Description=Copy netmon raw files to shared storage
After=network-online.target remote-fs.target
Wants=network-online.target

[Service]
Type=oneshot
User=netmon
EnvironmentFile=/etc/default/netmon-sync
ExecStartPre=/opt/netmon/sync_id.sh ${DEST}
ExecStart=/usr/bin/rsync -rt --mkpath --chmod=D755,F644 /var/lib/netmon/raw/ ${DEST}/
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
# /usr, /boot and /etc read-only. Not ProtectSystem=strict, whose
# ReadWritePaths=DEST systemd would set up as root before dropping to netmon:
# on a NAS that squashes root, that fails when root can't reach DEST.
ProtectSystem=full
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
