# Compacts the Iceberg table, expires snapshots older than 28 days and
# deletes files nothing uses. Installed with the converter by
# scripts/install_converter.sh, and reads the same settings.
[Unit]
Description=netmon Iceberg compaction and snapshot expiry
After=network-online.target remote-fs.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
# Not root (scripts/add_netmon_user.sh). The lock in /run and the run marker
# in /var/lib live in directories systemd makes for this user; the lock's
# outlives each run, since loads and maintenance share it.
User=netmon
RuntimeDirectory=netmon-iceberg
RuntimeDirectoryPreserve=yes
StateDirectory=netmon-iceberg
EnvironmentFile=/etc/default/netmon-iceberg
ExecStart=/opt/netmon/venv/bin/python /opt/netmon/to_iceberg.py --maintain --warehouse ${WAREHOUSE} --catalog ${CATALOG}
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
# The rest of the system read-only: the installer's drop-in adds WAREHOUSE with
# ReadWritePaths=, and systemd makes the state and runtime directories.
ProtectSystem=strict
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
