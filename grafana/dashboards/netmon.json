      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "netmon-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT sum(tcp_tx * scale) AS `TCP sent`, sum(tcp_rx * scale) AS `TCP received`,\n  sum(udp_tx * scale) AS `UDP sent`, sum(udp_rx * scale) AS `UDP received`,\n  sum(nfs_read * scale) AS `NFS read`, sum(nfs_write * scale) AS `NFS written`\nFROM netmon.traffic_live WHERE host IN (${host:singlequote}) AND $__timeFilter(ts)"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Network by process (top 10)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "netmon-clickhouse"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "netmon-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "timeseries",
          "rawSql": "WITH top AS (\n  SELECT comm FROM netmon.traffic_live WHERE host IN (${host:singlequote}) AND $__timeFilter(ts)\n  GROUP BY comm ORDER BY sum((tcp_tx + tcp_rx + udp_tx + udp_rx) * scale) DESC LIMIT 10\n)\nSELECT $__timeInterval(ts) AS time, comm,\n  sum((tcp_tx + tcp_rx + udp_tx + udp_rx) * scale) / $__interval_s AS bytes_per_s\nFROM netmon.traffic_live\nWHERE host IN (${host:singlequote}) AND $__timeFilter(ts) AND comm IN top\nGROUP BY time, comm ORDER BY time"
        }
      ],
      "interval": "10s"
    },
